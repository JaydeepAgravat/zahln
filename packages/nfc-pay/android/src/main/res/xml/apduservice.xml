    android:description="@string/nfc_pay_service"
    android:requireDeviceUnlock="false">
    <aid-group android:category="other" android:description="@string/nfc_pay_service">
        <aid-filter android:name="F05A41484C4E01" />
    </aid-group>
</host-apdu-service>
