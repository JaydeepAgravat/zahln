{
  "name": "@zaster/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Ember & ink for the web: Tailwind 4 theme generated from the shared tokens, plus the console's primitives.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "theme": "vitest run -u",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@zaster/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
