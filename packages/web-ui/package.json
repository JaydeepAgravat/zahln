{
  "name": "@zahln/web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Ember & ink for the web: Tailwind 4 theme generated from the shared tokens, plus the console's primitives.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.tsx",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "theme": "vitest run -u"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@zahln/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
