{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/drizzle/meta",
      "!**/*.gen.*",
      "!**/global.css",
      "!**/ios",
      "!**/android",
      "!packages/web-ui/src/theme.css",
      "!**/.rnstorybook/storybook.requires.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@zahln/consumer": "Packages never import from apps.",
                  "@zahln/merchant": "Packages never import from apps."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/mobile-core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@zahln/mobile-ui": "mobile-core is the lower layer: UI depends on core, never the reverse.",
                  "@zahln/consumer": "Packages never import from apps.",
                  "@zahln/merchant": "Packages never import from apps."
                }
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
