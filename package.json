{
  "name": "zaster",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "api": "pnpm --filter @zaster/api dev",
    "web": "pnpm --filter @zaster/web dev",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "pnpm --filter @zaster/api db:migrate",
    "db:seed": "pnpm --filter @zaster/api db:seed",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "consumer": "pnpm --filter @zaster/consumer start",
    "consumer:ios": "pnpm --filter @zaster/consumer ios",
    "consumer:android": "pnpm --filter @zaster/consumer android",
    "merchant": "pnpm --filter @zaster/merchant start",
    "merchant:ios": "pnpm --filter @zaster/merchant ios",
    "merchant:android": "pnpm --filter @zaster/merchant android",
    "pods": "pnpm --filter @zaster/consumer pods && pnpm --filter @zaster/merchant pods",
    "icons": "node scripts/generate-icons.mjs",
    "console": "pnpm --filter @zaster/console dev",
    "landing": "pnpm --filter @zaster/landing dev",
    "e2e": "pnpm --filter @zaster/web e2e",
    "e2e:mobile": "maestro test apps/consumer/e2e/happy-path.yaml apps/consumer/e2e/network-drop.yaml",
    "storybook": "pnpm --filter @zaster/web-ui storybook",
    "screens:web": "SCREENS=1 pnpm --filter @zaster/web exec playwright test --project=screens",
    "screens:mobile": "scripts/screens/mobile.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-js": "2.6.2",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}
