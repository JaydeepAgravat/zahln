DATABASE_URL=postgres://zahln:zahln@localhost:5432/zahln
TEST_DATABASE_URL=postgres://zahln:zahln@localhost:5432/zahln_test
PORT=4000
HOST=0.0.0.0
CHAOS_ENABLED=true
# HMAC key for QR intent references, at least 32 characters. Generate one with: openssl rand -base64 32
INTENT_SIGNING_SECRET=dev-only-intent-signing-secret-change-me
DEV_AUTH=true
# Shared ops token for the internal console (stand-in for SSO), at least 24 characters.
ADMIN_TOKEN=dev-admin-token-change-me-please
# Browser origins allowed to call the API with cookies (Zahln Web, the console).
WEB_ORIGINS=http://localhost:3000,http://localhost:5174
